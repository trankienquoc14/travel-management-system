# ==========================================
# CENTRALIZED CONFIGURATION FOR TRAVEL ERP (TEMPLATE)
# ==========================================

# 1. DATABASE CONFIGURATION (MySQL)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=travel_management

# 2. JWT SECURITY CONFIGURATION
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# 3. RABBITMQ CONFIGURATION
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# 4. MICROSERVICES PORT CONFIGURATION
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
TOUR_SERVICE_PORT=5002
BOOKING_SERVICE_PORT=5003
HR_SERVICE_PORT=5004

# 5. MICROSERVICE ROUTING URLS FOR API GATEWAY
AUTH_SERVICE_URL=http://localhost:5001
TOUR_SERVICE_URL=http://localhost:5002
BOOKING_SERVICE_URL=http://localhost:5003
HR_SERVICE_URL=http://localhost:5004

# 6. SEPAY & VIETQR REALTIME PAYMENT CONFIGURATION
# (Điền SePay API Token của bạn vào đây)
SEPAY_API_TOKEN=your_sepay_api_token_here
SEPAY_ACCOUNT_NUMBER=00000419627
SEPAY_ACCOUNT_NAME=DOAN THI TRAM
SEPAY_BANK_NAME=TPBank
SEPAY_BANK_CODE=TPB
SEPAY_BANK_BIN=970423

# 7. EMAIL CONFIGURATION (SMTP / GMAIL APP PASSWORD)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="TravelERP Du Lịch" <no-reply@travelerp.vn>

